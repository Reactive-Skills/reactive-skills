{
  "name": "@reactive-skills/workspace",
  "version": "0.10.0",
  "description": "Reactive Skills Architecture (RSA) — monorepo workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @reactive-skills/runtime build && pnpm --filter @reactive-skills/axi build",
    "test": "pnpm --filter @reactive-skills/runtime test",
    "test:axi": "pnpm --filter @reactive-skills/axi test",
    "test:all": "pnpm --filter @reactive-skills/runtime test && pnpm --filter @reactive-skills/axi test",
    "check:docs": "pnpm --filter @reactive-skills/runtime run check:docs",
    "check:prose": "pnpm --filter @reactive-skills/runtime run check:prose",
    "demo": "pnpm --filter @reactive-skills/runtime demo",
    "build:site": "node scripts/sync-registry.js && node scripts/sync-changelog.js && pnpm --filter @reactive-skills/site build",
    "dev:site": "pnpm --filter @reactive-skills/site dev",
    "dev:cms": "npx decap-server",
    "sync:registry": "node scripts/sync-registry.js",
    "sync:changelog": "node scripts/sync-changelog.js",
    "sync:all": "node scripts/sync-registry.js && node scripts/sync-changelog.js",
    "bump:patch": "pnpm --filter @reactive-skills/runtime run bump:patch",
    "bump:minor": "pnpm --filter @reactive-skills/runtime run bump:minor",
    "bump:major": "pnpm --filter @reactive-skills/runtime run bump:major",
    "release:patch": "pnpm --filter @reactive-skills/runtime run release:patch",
    "release:minor": "pnpm --filter @reactive-skills/runtime run release:minor",
    "release:major": "pnpm --filter @reactive-skills/runtime run release:major"
  },
  "devDependencies": {
    "@nx/eslint": "23.1.3",
    "@nx/eslint-plugin": "23.1.3",
    "@nx/js": "23.1.3",
    "@nx/next": "^23.1.3",
    "@nx/workspace": "^23.1.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.0",
    "nx": "23.1.3",
    "prettier": "~3.6.2",
    "typescript": "^5.7.3",
    "verdaccio": "^6.3.2"
  },
  "packageManager": "pnpm@11.24.0",
  "nx": {},
  "dependencies": {},
  "license": "AGPL-3.0-only"
}
